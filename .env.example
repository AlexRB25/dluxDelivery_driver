# Supabase de Dlux (Project Settings → API): URL y llave publicable (nunca la service role)
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# WhatsApp de soporte de Dlux a 10 dígitos (membresía y ayuda)
EXPO_PUBLIC_SOPORTE_WHATSAPP=
# Servidor de Dlux (el panel desplegado, p. ej. https://admin.dlux.app): pago de la membresía con tarjeta u OXXO
EXPO_PUBLIC_API_URL=
